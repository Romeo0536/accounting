# ===== Google Gemini API (AI อ่านบิล/ใบเสร็จ) =====
# สมัครและรับ key ได้ที่ https://aistudio.google.com/app/apikey (ฟรี)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# ===== LINE Bot Credentials =====
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ===== Email (Gmail SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=น้องโมจิ Bot

# ===== Bot Settings =====
BOT_NAME=น้องโมจิ
TIMEZONE=Asia/Bangkok
ADMIN_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Storage =====
STORAGE_PATH=./storage

# ===== Google Drive (ไม่บังคับ — ถ้าไม่ใส่จะเก็บแค่ local) =====
# สร้าง Service Account ที่ https://console.cloud.google.com/
# แล้ว share โฟลเดอร์ mochi ให้ service account email มีสิทธิ์ Editor
GDRIVE_CREDENTIALS_JSON=./service-account.json
# ถ้าต้องการระบุ folder ID ของโฟลเดอร์ mochi ที่แชร์ไว้แล้ว (ไม่ใส่ก็ได้ จะสร้างใน My Drive)
GDRIVE_MOCHI_FOLDER_ID=

# ===== Admin Panel =====
ADMIN_PORT=5002
ADMIN_PASSWORD=mochi2024
ADMIN_SECRET_KEY=change-this-to-a-random-secret

# ===== Flask =====
PORT=5001
DEBUG=false
