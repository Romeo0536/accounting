# LINE Bot — ตั้งค่าเมื่อพร้อมเชื่อมต่อ LINE จริง
# (ไม่ตั้งค่าก็ยังทดสอบผ่านหน้าเว็บ /line-bot ได้เต็มรูปแบบ)

# Channel access token จาก LINE Developers Console (Messaging API)
LINE_CHANNEL_ACCESS_TOKEN=

# Channel secret — ใช้ตรวจสอบลายเซ็น webhook (เว้นว่าง = ข้ามตรวจในโหมดพัฒนา)
LINE_CHANNEL_SECRET=

# ปลายทางแจ้งเตือนสรุปประจำวัน (userId ขึ้นต้น U... หรือ groupId ขึ้นต้น C...)
# ตั้งผ่านหน้าเว็บก็ได้ — ค่าในหน้าเว็บจะถูกใช้ก่อน
LINE_DEFAULT_TO=
